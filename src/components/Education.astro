---
const degrees = [
  {
    degree: "Master's Certificate in Project Management (PMP)",
    school: 'Project Management Institute',
    year: '2003 \u2013 2005',
  },
  {
    degree: "Master's in Commercial Project Management",
    school: 'The George Washington University School of Business',
    year: '2003 \u2013 2005',
  },
  {
    degree: "Master's in Industrial Engineering (Electronics & Telecom)",
    school: 'Thomas More University of Applied Sciences',
    year: '1988 \u2013 1992',
  },
  {
    degree: 'MBA (self-study)',
    school: 'Self-directed',
    year: '',
  },
  {
    degree: 'Portfolio & Program Management (self-study)',
    school: 'Self-directed',
    year: '',
  },
];

const certs = [
  'Generative AI Mastermind \u2013 Outskill',
  'Practical Application of GenAI for PMs \u2013 PMI',
  'Data Landscape of GenAI for PMs \u2013 PMI',
  'Talking to AI: Prompt Engineering for PMs \u2013 PMI',
  'Generative AI Overview for PMs \u2013 PMI',
  'Microsoft Certified Systems Engineer + Internet (MCSE+I)',
  'Data Center Consolidation \u2013 HPE',
  'Operational IT Management \u2013 HPE',
  'Solution Definition & Creation \u2013 HPE',
  'Business Process Re-engineering \u2013 Alcatel',
];
---

<section id="education">
  <div class="container">
    <h2>Education & Certifications</h2>
    <div class="edu-grid">
      <div>
        <h3 class="section-subtitle">Degrees</h3>
        <div class="edu-list">
          {degrees.map((d) => (
            <div class="edu-item">
              <div class="edu-degree">{d.degree}</div>
              <div class="edu-school">
                {d.school}
                {d.year && <> &middot; {d.year}</>}
              </div>
            </div>
          ))}
        </div>
      </div>
      <div>
        <h3 class="section-subtitle">Certifications</h3>
        <div class="cert-tags">
          {certs.map((c) => (
            <span class="tag">{c}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .edu-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .section-subtitle {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
    font-weight: 600;
  }

  .edu-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .edu-item {
    border-left: 2px solid var(--color-border);
    padding-left: 1rem;
  }

  .edu-degree {
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 0.2rem;
  }

  .edu-school {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .cert-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (max-width: 640px) {
    .edu-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
