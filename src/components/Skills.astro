---
const skillGroups = [
  {
    title: 'Management',
    skills: [
      'IT Program & Project Management',
      'Portfolio Management',
      'PMO Setup & Governance',
      'Team Leadership',
      'Vendor Management',
      'Stakeholder Management',
      'Risk & Dependency Management',
      'Budget & P&L Ownership',
    ],
  },
  {
    title: 'Technical',
    skills: [
      'IT Infrastructure (Network, Security, Cloud)',
      'Cloud Adoption (SaaS, IaaS)',
      'ERP Implementations',
      'Digital Transformation',
      'Data Center Modernization',
      'MSP & Vendor Transitions',
      'Microsoft & Cisco Ecosystems',
      'Jira, Planview, MS Project',
      'Identity Governance & Administration (IGA)',
      'Identity & Access Management (IAM)',
      'Privileged Access Management (PAM)',
      'Security Program Delivery',
    ],
  },
  {
    title: 'Methodologies',
    skills: [
      'Prince2 Practitioner',
      'PMP / PMBOK',
      'Agile & Scrum',
      'SAFe',
      'Waterfall',
      'Hybrid Delivery',
      'ITIL',
    ],
  },
];

const passions = [
  'IGA/IAM & Identity Security',
  'Cloud & Hybrid Infrastructure',
  'Strategic Portfolio Management & PMO',
  'AI in Project & Program Management',
  'Infrastructure & ERP Digital Transformations',
];
---

<section id="skills">
  <div class="container">
    <h2>Skills & Expertise</h2>
    <div class="skills-grid">
      {skillGroups.map((group) => (
        <div class="skill-group">
          <h3>{group.title}</h3>
          <div class="skill-tags">
            {group.skills.map((s) => (
              <span class="tag">{s}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="passions">
      <h3>Current Passions</h3>
      <div class="passion-tags">
        {passions.map((p) => (
          <span class="tag tag-accent">{p}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .skill-group h3 {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    display: inline-block;
    padding: 0.4rem 0.85rem;
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    transition: background 0.2s, color 0.2s;
  }

  .tag:hover {
    background: var(--color-accent);
    color: #ffffff;
  }

  .passions {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .passions h3 {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .passion-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-accent {
    background: var(--color-accent-light);
    color: var(--color-accent);
    font-weight: 600;
    border: 1px solid rgba(8, 145, 178, 0.2);
  }

  .tag-accent:hover {
    background: var(--color-accent);
    color: #ffffff;
  }
</style>
