---
const metrics = [
  { value: '20+', label: 'Years Experience' },
  { value: '9.2M\u20AC', label: 'Largest Budget' },
  { value: '37', label: 'Sites (1 Program)' },
  { value: '13', label: 'Countries' },
];
---

<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-photo">
        <img src="/profile.jpg" alt="Ralf Lauwers" width="120" height="120" />
      </div>
      <div class="hero-main">
        <p class="hero-label">Senior IT Program, Portfolio & PMO Manager</p>
        <h1>Ralf Lauwers</h1>
        <p class="hero-tagline">
          20+ Years &middot; IGA/IAM Security &middot; IT Program &amp; Portfolio Management &middot;
          Digital &amp; Infrastructure Transformation &middot; Logistics &middot; Government &middot;
          Pharma &middot; Telecom &middot; Banking
        </p>
        <div class="hero-location">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Vosselaar, Belgium &middot; Hybrid / Remote
        </div>
        <div class="hero-cta">
          <a href="#contact" class="btn btn-primary">Get in Touch</a>
          <a href="/cv.pdf" class="btn btn-outline" download>Download CV (PDF)</a>
          <a href="#experience" class="btn btn-ghost">View Experience</a>
        </div>
      </div>
      <div class="hero-metrics">
        {metrics.map((m) => (
          <div class="metric-card">
            <span class="metric-value">{m.value}</span>
            <span class="metric-label">{m.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, #1e293b 100%);
    color: #ffffff;
    padding: 5rem 0 4rem;
  }

  .hero-grid {
    display: flex;
    align-items: center;
    gap: 3rem;
  }

  .hero-photo {
    flex-shrink: 0;
  }

  .hero-photo img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.2);
    object-fit: cover;
  }

  .hero-main {
    flex: 1;
  }

  .hero-label {
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .hero h1 {
    font-size: 3.2rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .hero-tagline {
    font-size: 1.1rem;
    color: #94a3b8;
    line-height: 1.5;
    margin-bottom: 1.25rem;
    max-width: 600px;
  }

  .hero-location {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: #94a3b8;
    margin-bottom: 2rem;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.2s;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--color-accent);
    color: #ffffff;
  }

  .btn-primary:hover {
    background: #0e7490;
    color: #ffffff;
  }

  .btn-outline {
    background: transparent;
    color: #ffffff;
    border: 1.5px solid #475569;
  }

  .btn-outline:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .btn-ghost {
    background: transparent;
    color: #94a3b8;
    border: 1.5px solid transparent;
  }

  .btn-ghost:hover {
    color: #ffffff;
    border-color: #475569;
  }

  .hero-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    flex-shrink: 0;
  }

  .metric-card {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    text-align: center;
  }

  .metric-value {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1.1;
  }

  .metric-label {
    font-size: 0.8rem;
    color: #94a3b8;
    margin-top: 0.25rem;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 3rem 0 2.5rem;
    }
    .hero-grid {
      flex-direction: column;
      gap: 1.5rem;
    }
    .hero h1 {
      font-size: 2.4rem;
    }
    .hero-metrics {
      grid-template-columns: repeat(4, 1fr);
      width: 100%;
    }
    .metric-card {
      padding: 0.75rem;
    }
    .metric-value {
      font-size: 1.4rem;
    }
  }

  @media (max-width: 480px) {
    .hero-metrics {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
